[submodule "packages/durin/lib/openzeppelin-contracts"]
	path = packages/durin/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "packages/durin/lib/forge-std"]
	path = packages/durin/lib/forge-std
	url = https://github.com/foundry-rs/forge-std
[submodule "packages/durin/lib/foundry-multichain-deploy"]
	path = packages/durin/lib/foundry-multichain-deploy
	url = https://github.com/chainsafe/foundry-multichain-deploy
[submodule "packages/durin/lib/ens-contracts"]
	path = packages/durin/lib/ens-contracts
	url = https://github.com/ensdomains/ens-contracts
[submodule "packages/durin/lib/solidity-stringutils"]
	path = packages/durin/lib/solidity-stringutils
	url = https://github.com/Arachnid/solidity-stringutils
[submodule "packages/durin/lib/openzeppelin-contracts-upgradeable"]
	path = packages/durin/lib/openzeppelin-contracts-upgradeable
	url = https://github.com/OpenZeppelin/openzeppelin-contracts-upgradeable
